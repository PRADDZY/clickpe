{
  "name": "03 ? Preview matches and send controlled SES demo",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "notification-preview",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {
          "allowedOrigins": ""
        }
      },
      "id": "a1167d84-378b-4a8f-8d6b-13c10a8ba688",
      "name": "Receive completed run",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        260
      ],
      "webhookId": "4ba0a872-6c40-4290-a911-9fa2b64281df",
      "credentials": {
        "httpHeaderAuth": {
          "id": "clickpe-internal",
          "name": "ClickPe internal API"
        }
      }
    },
    {
      "name": "Prepare preview and claim test delivery",
      "id": "30709dff-2b34-4ca0-9746-7b25289607a3",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://api:8000/internal/v1/prepare-notifications/' + $json.body.run_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 30000
        }
      },
      "position": [
        500,
        260
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "clickpe-internal",
          "name": "ClickPe internal API"
        }
      }
    },
    {
      "name": "Controlled test delivery enabled?",
      "id": "ecd39606-2b83-4945-8237-b14748ca67d0",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.delivery_enabled }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "position": [
        740,
        260
      ]
    },
    {
      "name": "Send one controlled test email",
      "id": "5b0f1218-c7c3-4785-af4e-2da7e02617a0",
      "type": "n8n-nodes-base.awsSes",
      "typeVersion": 1,
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "={{ $json.sender }}",
        "toAddresses": [
          "={{ $json.recipient }}"
        ],
        "subject": "={{ $json.subject }}",
        "body": "={{ $json.body }}",
        "isBodyHtml": false,
        "additionalFields": {}
      },
      "position": [
        990,
        180
      ],
      "retryOnFail": false,
      "credentials": {
        "aws": {
          "id": "clickpe-ses",
          "name": "ClickPe SES test sender"
        }
      }
    },
    {
      "name": "Record SES receipt",
      "id": "62b1b515-7943-4c1b-8eba-d1f9d4de61d2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/internal/v1/notification-receipt",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({delivery_id: $('Prepare preview and claim test delivery').item.json.delivery_id,message_id:($json.MessageId || $json.SendEmailResult?.MessageId || $json.SendEmailResponse?.SendEmailResult?.MessageId)}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "position": [
        1230,
        180
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "clickpe-internal",
          "name": "ClickPe internal API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "name": "Preview complete",
      "id": "cf45c784-3875-4b81-bd18-00c4ae198fce",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {},
      "position": [
        990,
        390
      ]
    }
  ],
