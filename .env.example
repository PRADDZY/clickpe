# Local development settings. Generate a private .env with scripts/New-Environment.ps1.
APP_ENV=development
DATABASE_URL=postgresql://loan_engine:SET_POSTGRES_PASSWORD@db:5432/loan_engine
POSTGRES_PASSWORD=GENERATED_LOCAL_SECRET
LOCAL_UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=26214400
RETENTION_DAYS=7
OPERATOR_TOKEN=GENERATED_OPERATOR_SECRET
INTERNAL_API_TOKEN=GENERATED_WORKFLOW_SECRET
N8N_WEBHOOK_URL=http://n8n:5678/webhook/match-run
N8N_ENCRYPTION_KEY=GENERATED_PERSISTENT_ENCRYPTION_KEY
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_AUTH_TOKEN=GENERATED_RUNNER_SECRET
AWS_REGION=ap-south-1
S3_UPLOAD_BUCKET=
TEST_RECIPIENTS=
NOTIFICATION_MODE=preview
